# Template for backend/app/.env — copy this file to `.env` in the same
# directory and fill in real values. `.env` is gitignored so secrets stay
# off the wire.
#
#   cp .env.example .env
#   $EDITOR .env

# Google AI Studio API key — required. Powers the narrator and the
# handle-discovery LLM calls. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here

# IntelligenceX API key — required for paste-site / leak / darknet
# search. Free tier is fine. Sign up + get a key at
# https://intelx.io/account?tab=developer
INTELX_API_KEY=your-intelx-key-here

# GitHub personal access token — OPTIONAL. Unauthenticated commit-search
# is capped at 60 requests/hour; supplying a token raises this to
# 5000/hour. No scopes needed; a fine-grained "public repos read" PAT is
# sufficient. Generate at https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-token-here

# CORS allowlist — OPTIONAL override. Comma-separated origins the
# FastAPI server accepts. Default covers Vite's dev origin (5173) and
# the backend's own port (8080). Override when hosting under a real
# domain.
# ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
